# SidiWeb Backend (FastAPI) environment

# App
ENVIRONMENT=development

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=sidiweb_db

# Security / JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Service
FASTAPI_PORT=8000
UPLOAD_DIR=src/media/uploads

# AI recommendation service (see /ai)
IA_API_URL=http://localhost:5001
