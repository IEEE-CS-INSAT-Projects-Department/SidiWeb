# Root environment for docker compose (interpolated into docker-compose.yml)
# Copy to .env and fill in. All values have safe dev defaults except where noted.

# Host ports — override any that are already taken on your machine
BACKEND_PORT=8000
FRONTEND_PORT=5173
MONGO_PORT=27017

# Backend JWT signing key — CHANGE THIS for anything beyond local dev
JWT_SECRET_KEY=dev-secret-change-me

# Google Gemini key for the AI recommendation service (optional locally;
# the backend has a fallback so the app still works without it)
GOOGLE_API_KEY=
OPENAI_API_KEY=
